# Supabase project "Diis Project" -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://vzwythpeoicprtwtbdau.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY - never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Usernames are stored as <username>@<this domain> in Supabase Auth. No emails are ever sent to it.
NEXT_PUBLIC_USERNAME_DOMAIN=users.diis.app
